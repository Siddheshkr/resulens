# Clerk owns authentication and sessions.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase uses Clerk session tokens through its native third-party integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker/admin-only. Never expose this through NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Resume processing. These are server/worker-only and are never sent to the browser.
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-5.6-luna
OPENAI_RESUME_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MATCH_EXPLANATION_MODEL=gpt-5.6-luna
# Reviewed provider prices in micro-USD per million tokens, keyed by exact model name.
AI_COST_RATES_JSON={}
AI_SPEND_ALERT_MICROUSD_24H=
RESUME_WORKER_SECRET=
RESUME_WORKER_BATCH_SIZE=3
RESULENS_APP_URL=http://127.0.0.1:3000

# Matching worker. The secret is shared only by the Edge Function and server route.
MATCHING_WORKER_SECRET=
MATCHING_WORKER_BATCH_SIZE=5

# Job ingestion is server/worker-only. Provider credentials never reach the browser.
JOB_INGESTION_SECRET=
JOB_INGESTION_MAX_PAGES=5
JOB_INGESTION_MAX_SOURCES=3
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY_CODE=in
ADZUNA_DEFAULT_QUERY=

# Phase 5 maintenance. Share only between the app and scheduled Edge Function.
OPERATIONS_WORKER_SECRET=

# Sentry is optional locally. Auth tokens are build/deployment-only and never reach the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02
